{
  "name": "dentalmap-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:push:preview": "drizzle-kit push",
    "auth:generate": "auth generate --output src/db/auth-schema.ts -y",
    "codegen": "dotenv -e .env.local -- graphql-codegen --config codegen.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "html-react-parser": "^6.1.7",
    "maplibre-gl": "^6.9.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.27.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.4",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22 <23"
  }
}
