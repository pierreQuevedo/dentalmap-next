DATABASE_URL=
WP_GRAPHQL_URL=https://cms.dentalmap.fr/graphql
# Clé partagée avec le back-office WordPress (constante DM_API_KEY du wp-config) : tickets SAV du formulaire de contact
DM_API_KEY=
REVALIDATE_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
# Pro Santé Connect (vérification d'identité des chirurgiens-dentistes).
# Vide : la vérification manuelle seule est proposée. Voir docs/pro-sante-connect.md
PSC_CLIENT_ID=
PSC_CLIENT_SECRET=
# Bac à sable par défaut ; en production : https://auth.esw.esante.gouv.fr/auth/realms/esante-wallet
PSC_ISSUER=
# Facultatif, déduit de BETTER_AUTH_URL : doit être déclaré à l'ANS tel quel, barre finale comprise.
# Le bac à sable n'accepte que https://localhost/* : `pnpm dev:psc` sert le site sur https://localhost (port 443).
PSC_REDIRECT_URI=
# Simulateur local de Pro Santé Connect (développement seulement, ignoré en production Vercel).
# À 1, le parcours complet se teste sans identifiants ANS : voir docs/pro-sante-connect.md
PSC_SIMULATEUR=
# Destinataire des demandes de partenariat du formulaire de l'accueil (défaut contact@dentalmap.fr).
CONTACT_EMAIL=
# Modérateurs des revendications et demandes de création de fiche : emails séparés par des virgules.
MODERATEURS=

# Tâches planifiées (alertes « fiche créée ») : en-tête Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Bandeau de cookies Axeptio (console Axeptio, projet DentalMap). Sans identifiant, le bandeau ne se charge pas et tout reste refusé.
NEXT_PUBLIC_AXEPTIO_CLIENT_ID=
NEXT_PUBLIC_AXEPTIO_COOKIES_VERSION=
